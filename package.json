{
  "name": "express-emits",
  "version": "0.1.0",
  "description": "Typed EventEmitter-based request/middleware instrumentation for Express.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "nodemon --ext ts --ignore dist --exec \"tsc && node dist/main.js\"",
    "test": "tsc && node --test dist/*.test.js"
  },
  "keywords": ["express", "middleware", "logging", "events"],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "devDependencies": {
    "express": "^5.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
